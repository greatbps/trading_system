# 한국투자증권 API 설정
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NUMBER=your_account_number_here
KIS_USER_ID=your_user_id_here

# 네이버 뉴스 API
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# 텔레그램 봇
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_IDS=your_chat_id1,your_chat_id2

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# OpenAI GPT API
OPENAI_API_KEY=your_openai_api_key

# LLM 설정
PRIMARY_ANALYZER=gpt
FALLBACK_ANALYZER=gemini

# PostgreSQL 데이터베이스 설정
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# 또는 전체 DATABASE_URL을 직접 설정
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_system
